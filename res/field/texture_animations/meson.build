# ABOUTME: Builds the field texture animation archive (data/fldtanime.narc) from texture_animations.json.
# ABOUTME: Every frames NSBTX the JSON refers to must also be listed here; the packer checks both agree.

texture_animation_frames = files(
    'frames/asahamabe.nsbtx',
    'frames/asasea.nsbtx',
    'frames/azt_wall02_1.nsbtx',
    'frames/bf_hata02_1.nsbtx',
    'frames/bf_lakep_1.nsbtx',
    'frames/c1_lamp01.nsbtx',
    'frames/c1_lamp02.nsbtx',
    'frames/c3_s03b_1.nsbtx',
    'frames/dun16_wall_1.nsbtx',
    'frames/dun_sea.nsbtx',
    'frames/gingaanm_1.nsbtx',
    'frames/gym04_fl_p_1.nsbtx',
    'frames/gym04_fl_r_1.nsbtx',
    'frames/hamabe.nsbtx',
    'frames/lakep_1.nsbtx',
    'frames/lost_kebe.nsbtx',
    'frames/m_4ten_hi_1.nsbtx',
    'frames/m_bf05_hsr1_1.nsbtx',
    'frames/m_bf05_light03.nsbtx',
    'frames/mc_gamen_1.nsbtx',
    'frames/numa_b.nsbtx',
    'frames/numa_b2.nsbtx',
    'frames/numa_c.nsbtx',
    'frames/numa_c2.nsbtx',
    'frames/numa_d.nsbtx',
    'frames/numa_d2.nsbtx',
    'frames/numa_e.nsbtx',
    'frames/numa_e2.nsbtx',
    'frames/numa_f1b.nsbtx',
    'frames/numa_f1c.nsbtx',
    'frames/numa_f1de.nsbtx',
    'frames/pikao_1.nsbtx',
    'frames/pikar_1.nsbtx',
    'frames/pikay_1.nsbtx',
    'frames/rhana.nsbtx',
    'frames/sea.nsbtx',
    'frames/searock.nsbtx',
    'frames/t3_fl_b_1.nsbtx',
    'frames/t3_fl_p_1.nsbtx',
    'frames/t3_fl_r_1.nsbtx',
    'frames/t3_fl_y_1.nsbtx',
    'frames/warp00_1.nsbtx',
    'frames/wtk_kabe1.nsbtx',
    'frames/wtk_kabe11_0.nsbtx',
    'frames/wtk_kabe12_0.nsbtx',
    'frames/wtk_kabe13_0.nsbtx',
    'frames/wtk_kabe2.nsbtx',
    'frames/wtk_kabe3.nsbtx',
    'frames/yomawaru_1.nsbtx',
    'frames/yuka_ora_1.nsbtx',
    'frames/yuka_red_1.nsbtx',
    'frames/yuka_yellow_1.nsbtx',
)

texture_animations_narc = custom_target('texture_animations.narc',
    output: 'texture_animations.narc',
    input: [ files('texture_animations.json'), texture_animation_frames ],
    command: [
        make_texture_animations_py,
        '--nitroarc', nitroarc_exe,
        '--staging', '@PRIVATE_DIR@',
        '--output', '@OUTPUT@',
        '@INPUT@',
    ],
)

nitrofs_files += texture_animations_narc
